# Environment variables (copy to `.env`)
# Prefix is always TDT_

TDT_HOST=127.0.0.1
TDT_PORT=8787
TDT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TDT_ENV=development
# Required when TDT_ENV=production — never use the default in production
TDT_TOKEN_SECRET=tdt-dev-secret
# 任务存储：仅 sqlite（JSON 已废弃）。首次启动会把旧的 initiatives.json 自动导入，
# 并保留一份 initiatives.json.bak-<时间戳> 备份。
TDT_STORAGE=sqlite
# Run queue: inline (default) | sqlite (multi-worker lease)
# sqlite 后端要求 TDT_STORAGE=sqlite（多 worker 并发写 JSON 会丢任务）
TDT_RUN_BACKEND=inline
# Worker 身份留空即可：默认派生 "{hostname}-{pid}"，多副本天然唯一。
# 只有需要固定名字时才显式填写——写成同名会让队列的 mission 互斥失效。
# TDT_WORKER_ID=
# 本进程是否消费队列；多副本部署时 API 端置 false，另起 sortie worker
TDT_RUN_WORKER=true
# Artifacts: local | s3 (requires pip install '.[s3]')
TDT_ARTIFACT_BACKEND=local
# TDT_S3_BUCKET=
# TDT_S3_ENDPOINT=http://127.0.0.1:9000
# TDT_S3_PREFIX=artifacts
# TDT_S3_ACCESS_KEY=
# TDT_S3_SECRET_KEY=
# Org policy (optional JSON)
# TDT_ORG_POLICY_PATH=packages/policies/default.json
# Enterprise knowledge — WeKnora (Tencent OSS). Sortie Deck imports + catalogs; retrieve via WeKnora.
TDT_KB_BACKEND=local
# TDT_KB_BACKEND=weknora
# TDT_WEKNORA_BASE_URL=http://127.0.0.1:8080
# TDT_WEKNORA_API_KEY=
# TDT_WEKNORA_KB_ID=
# 检索模式：hybrid = hybrid-search（BM25+向量，快）；graph = knowledge-chat 管线（Neo4j 图谱扩展，慢）
# TDT_WEKNORA_RETRIEVAL_MODE=graph
# TDT_WEKNORA_CHAT_TIMEOUT=90
# Chat bridges
# TDT_SLACK_SIGNING_SECRET=
# TDT_FEISHU_VERIFICATION_TOKEN=
TDT_DEPLOY_EXECUTOR=mock
# TDT_DEPLOY_CMD=echo deploy {initiative_id}
# TDT_POSTGRES_URI=postgresql://user:pass@localhost:5432/sortie
TDT_ENG_CONCURRENCY=3
# Optional LLM (OpenAI-compatible) — or Claude CLI fallback when no key
# TDT_LLM_API_KEY=
# OPENAI_API_KEY=
# TDT_LLM_BASE_URL=https://api.openai.com/v1
# TDT_LLM_MODEL=gpt-4o-mini
# TDT_PIPELINE_LLM=true
# TDT_ROOM_LLM=true
# TDT_LLM_CLI_FALLBACK=true
# mock | claude_code | cursor_cli | auto
# TDT_DEFAULT_CODING_EXECUTOR=auto
# Claude Code --permission-mode for non-interactive worktree runs
# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
# TDT_CODING_PERMISSION_MODE=acceptEdits
# Coding CLI timeout (seconds); permission HITL can retry with bypassPermissions
# TDT_CODING_TIMEOUT_SECONDS=900
# TDT_MCP_RUNTIME=false
TDT_LOG_LEVEL=INFO
# Stage executor timeout (seconds)
TDT_STAGE_TIMEOUT_SECONDS=1800
