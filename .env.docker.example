# 容器部署用的环境变量模板：cp .env.docker.example .env 后按需修改。
# 这些值会被 docker-compose.yml 里的 environment 覆盖项补齐。

# --- 必填 ---------------------------------------------------------------
# 生产环境必须换掉默认值，否则任何人都能伪造登录态
TDT_ENV=production
TDT_TOKEN_SECRET=change-me-to-a-long-random-string

# 客户端（本地 Claude Code / CLI）能访问到的地址；生成 MCP 配置片段用
# 内网直连：http://192.168.1.10:8787    上了 Caddy：https://sortie.example.com
TDT_PUBLIC_BASE_URL=http://127.0.0.1:8787

# --- 存储 / 队列（compose 已设置，保留以便单独运行容器）------------------
TDT_DATA_DIR=/data
TDT_STORAGE=sqlite
TDT_RUN_BACKEND=sqlite

# --- 执行 ---------------------------------------------------------------
# 有真实 LLM 就配上；否则 claude CLI 回退会让每个阶段可能等满超时
# TDT_LLM_API_KEY=
# TDT_LLM_BASE_URL=https://api.openai.com/v1
# TDT_LLM_MODEL=gpt-4o-mini
# TDT_LLM_CLI_FALLBACK=0
TDT_DEFAULT_HARNESS=mock
TDT_DEFAULT_CODING_EXECUTOR=mock

# --- 安全 ---------------------------------------------------------------
# 留空 = 关闭 DNS-rebinding 防护（身份由 API Key 保证）；上公网建议填域名
# TDT_MCP_ALLOWED_HOSTS=sortie.example.com
TDT_API_KEY_RATE_LIMIT_PER_MINUTE=240
